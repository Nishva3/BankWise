# ==========================================
# BANKWISE - GITIGNORE
# ==========================================

# Python virtual environments
venv/
.venv/
env/
ENV/

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Environment variables and secrets
.env
.env.*
!.env.example

# Uploaded files and user data
uploads/
backend/uploads/
*.pdf
*.csv
*.xlsx
*.xls

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp

# Machine Learning temporary files
*.joblib.tmp
*.pkl.tmp
*.model.tmp

# Jupyter Notebook
.ipynb_checkpoints/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Build and distribution
build/
dist/
*.egg-info/

# Node.js dependencies (if applicable)
node_modules/
npm-debug.log*
yarn-debug.log*

# Frontend build files
frontend/dist/
frontend/build/

# IDE settings
.vscode/
.idea/
*.sublime-workspace

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Docker temporary files
.docker/

# Local database files
*.sqlite
*.sqlite3
*.db

# Personal credentials and keys
*.pem
*.key
credentials.json
service-account.json

